<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalVibe.Pages.Shared.RegisterPage"
             Title="RegisterPage" Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">
    <Grid>
        <!-- TŁO GRADIENTOWE -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F6FF" Offset="0.0"/>
                    <GradientStop Color="#F8FAFF" Offset="0.55"/>
                    <GradientStop Color="#F0EFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- DEKORACYJNE ELEMENTY -->
        <Border
            WidthRequest="220"
            HeightRequest="220"
            StrokeThickness="0"
            BackgroundColor="#304EB9E6"
            StrokeShape="RoundRectangle 110"
            HorizontalOptions="End"
            VerticalOptions="Start"
            TranslationX="100"
            TranslationY="-100"/>

        <Border
            WidthRequest="155"
            HeightRequest="155"
            StrokeThickness="0"
            BackgroundColor="#20A78BFA"
            StrokeShape="RoundRectangle 78"
            HorizontalOptions="Start"
            VerticalOptions="End"
            TranslationX="-85"
            TranslationY="55"/>

        <ScrollView>
            <VerticalStackLayout
                Padding="25,18,25,30"
                Spacing="0">

                <!-- POWRÓT -->
                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">

                    <Border
                        BackgroundColor="#DFFFFFFF"
                        Stroke="#BFE4F5"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        WidthRequest="44"
                        HeightRequest="44">

                        <Label
                            Text="←"
                            FontSize="25"
                            TextColor="#187BA8"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <Label
                        Grid.Column="1"
                        Text="Powrót do strony głównej"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#58758C"
                        VerticalOptions="Center">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- LOGO -->
                <VerticalStackLayout
                    Spacing="3"
                    HorizontalOptions="Center"
                    Margin="0,22,0,23">

                    <Grid WidthRequest="76" HeightRequest="67">

                        <Border
                            BackgroundColor="#E1F4FF"
                            Stroke="#BDE7FA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 24"
                            WidthRequest="68"
                            HeightRequest="64"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="☀"
                            FontSize="38"
                            TextColor="#FFBE4A"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-4,0,0"/>

                        <Label
                            Text="☁"
                            FontSize="43"
                            TextColor="#258FCB"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            Margin="0,0,0,-5"/>
                    </Grid>

                    <Label
                        Text="LocalVibe"
                        FontSize="31"
                        FontAttributes="Bold"
                        CharacterSpacing="-0.7"
                        TextColor="#187BA8"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="POGODA. LUDZIE. TWOJE CHWILE."
                        FontSize="9"
                        CharacterSpacing="1.7"
                        TextColor="#829BB1"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- NAGŁÓWEK -->
                <VerticalStackLayout Spacing="8" Margin="0,0,0,22">

                    <Border
                        BackgroundColor="#DFF3FF"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="11,6"
                        HorizontalOptions="Start">

                        <HorizontalStackLayout Spacing="6">
                            <Label Text="✦" FontSize="12" TextColor="#168BE0"/>
                            <Label
                                Text="DOŁĄCZ DO NAS"
                                FontSize="9"
                                CharacterSpacing="1.3"
                                FontAttributes="Bold"
                                TextColor="#187BA8"
                                VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Label
                        Text="Stwórz swoje konto"
                        FontSize="30"
                        FontAttributes="Bold"
                        CharacterSpacing="-0.8"
                        TextColor="#192D45"
                        LineBreakMode="WordWrap"/>

                    <Label
                        Text="Dołącz do społeczności, która uchwyca codzienność razem z pogodą."
                        FontSize="14"
                        LineHeight="1.3"
                        TextColor="#73869A"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>

                <!-- KARTA FORMULARZA -->
                <Border
                    BackgroundColor="#FDFEFFFF"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 27"
                    Padding="20">

                    <Border.Shadow>
                        <Shadow
                            Brush="#183C75A5"
                            Offset="0,9"
                            Radius="22"
                            Opacity="0.12"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <Label
                            Text="Twoje dane"
                            FontSize="19"
                            FontAttributes="Bold"
                            TextColor="#20374D"/>

                        <Label
                            Text="Wypełnij formularz, aby rozpocząć."
                            FontSize="12"
                            TextColor="#8A9BAC"
                            Margin="0,5,0,20"/>

                        <!-- NAZWA UŻYTKOWNIKA -->
                        <Label
                            Text="Nazwa użytkownika"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#425B70"
                            Margin="2,0,0,8"/>

                        <Border
                            BackgroundColor="#F7FBFF"
                            Stroke="#D8E8F3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="13,2">

                            <Grid ColumnDefinitions="35,*" ColumnSpacing="9">

                                <Border
                                    BackgroundColor="#E3F4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="35"
                                    HeightRequest="35"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="☺"
                                        FontSize="20"
                                        TextColor="#258FCB"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Entry
                                    x:Name="UsernameEntry"
                                    Grid.Column="1"
                                    Placeholder="Jak mamy Cię nazywać?"
                                    TextColor="#20374D"
                                    PlaceholderColor="#9AABBA"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    MaxLength="30"
                                    HeightRequest="49"/>
                            </Grid>
                        </Border>

                        <!-- E-MAIL -->
                        <Label
                            Text="Adres e-mail"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#425B70"
                            Margin="2,18,0,8"/>

                        <Border
                            BackgroundColor="#F7FBFF"
                            Stroke="#D8E8F3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="13,2">

                            <Grid ColumnDefinitions="35,*" ColumnSpacing="9">

                                <Border
                                    BackgroundColor="#E3F4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="35"
                                    HeightRequest="35"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="✉"
                                        FontSize="17"
                                        TextColor="#258FCB"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Entry
                                    x:Name="EmailEntry"
                                    Grid.Column="1"
                                    Placeholder="np. jan@email.com"
                                    Keyboard="Email"
                                    TextColor="#20374D"
                                    PlaceholderColor="#9AABBA"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    ClearButtonVisibility="WhileEditing"
                                    HeightRequest="49"/>
                            </Grid>
                        </Border>

                        <!-- HASŁO -->
                        <Label
                            Text="Hasło"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#425B70"
                            Margin="2,18,0,8"/>

                        <Border
                            BackgroundColor="#F7FBFF"
                            Stroke="#D8E8F3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="13,2">

                            <Grid ColumnDefinitions="35,*" ColumnSpacing="9">

                                <Border
                                    BackgroundColor="#E3F4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="35"
                                    HeightRequest="35"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="◆"
                                        FontSize="16"
                                        TextColor="#258FCB"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Entry
                                    x:Name="PasswordEntry"
                                    Grid.Column="1"
                                    Placeholder="Utwórz hasło"
                                    IsPassword="True"
                                    TextColor="#20374D"
                                    PlaceholderColor="#9AABBA"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    HeightRequest="49"/>
                            </Grid>
                        </Border>

                        <!-- POWTÓRZ HASŁO -->
                        <Label
                            Text="Powtórz hasło"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#425B70"
                            Margin="2,18,0,8"/>

                        <Border
                            BackgroundColor="#F7FBFF"
                            Stroke="#D8E8F3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15"
                            Padding="13,2">

                            <Grid ColumnDefinitions="35,*" ColumnSpacing="9">

                                <Border
                                    BackgroundColor="#E3F4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="35"
                                    HeightRequest="35"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="◆"
                                        FontSize="16"
                                        TextColor="#258FCB"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"/>
                                </Border>

                                <Entry
                                    x:Name="ConfirmPasswordEntry"
                                    Grid.Column="1"
                                    Placeholder="Wpisz hasło ponownie"
                                    IsPassword="True"
                                    TextColor="#20374D"
                                    PlaceholderColor="#9AABBA"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    HeightRequest="49"/>
                            </Grid>
                        </Border>

                        <!-- ZGODA NA POLITYKĘ -->
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8"
                            Margin="0,20,0,22"
                            HorizontalOptions="Fill">

                            <CheckBox
                                x:Name="TermsCheckBox"
                                Grid.Column="0"
                                Color="#4EB9E6"
                                VerticalOptions="Start"
                                HorizontalOptions="Start"
                                Margin="-6,0,0,0"/>

                            <Label
                                Grid.Column="1"
                                FontSize="12"
                                TextColor="#71808D"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                LineBreakMode="WordWrap">

                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Akceptuję "/>
                                        <Span
                                            Text="politykę prywatności"
                                            TextColor="#187BA8"
                                            FontAttributes="Bold"/>
                                        <Span Text=" i zasady korzystania z aplikacji."/>
                                    </FormattedString>
                                </Label.FormattedText>

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnPrivacyPolicyClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <!-- PRZYCISK REJESTRACJI -->
                        <Border
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="0">

                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#168BE0" Offset="0.0"/>
                                    <GradientStop Color="#36B0E9" Offset="0.55"/>
                                    <GradientStop Color="#62C5EE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Border.Shadow>
                                <Shadow
                                    Brush="#4536A8E0"
                                    Offset="0,6"
                                    Radius="12"
                                    Opacity="0.35"/>
                            </Border.Shadow>

                            <Button
                                Text="Utwórz konto    →"
                                Clicked="OnRegisterClicked"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HeightRequest="54"
                                CornerRadius="16"/>
                        </Border>

                        <!-- PRZEJŚCIE DO LOGOWANIA -->
                        <Grid
                            ColumnDefinitions="*,Auto,*"
                            ColumnSpacing="10"
                            Margin="0,23,0,0">

                            <BoxView
                                HeightRequest="1"
                                Color="#E2EBF2"
                                VerticalOptions="Center"/>

                            <Label
                                Grid.Column="1"
                                Text="MASZ JUŻ KONTO?"
                                FontSize="9"
                                CharacterSpacing="1"
                                TextColor="#91A1B0"
                                VerticalOptions="Center"/>

                            <BoxView
                                Grid.Column="2"
                                HeightRequest="1"
                                Color="#E2EBF2"
                                VerticalOptions="Center"/>
                        </Grid>

                        <Border
                            BackgroundColor="White"
                            Stroke="#B9E4F8"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16"
                            Padding="0"
                            Margin="0,16,0,0">

                            <Button
                                Text="Zaloguj się    ↗"
                                Clicked="OnLoginClicked"
                                BackgroundColor="Transparent"
                                TextColor="#187BA8"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="52"
                                CornerRadius="16"/>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- KARTA POWITALNA -->
                <Border
                    BackgroundColor="#E7F5FF"
                    Stroke="#D6ECFA"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="15"
                    Margin="0,20,0,0">

                    <Grid ColumnDefinitions="44,*" ColumnSpacing="12">

                        <Border
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13"
                            WidthRequest="44"
                            HeightRequest="44"
                            VerticalOptions="Center">

                            <Label
                                Text="🌤"
                                FontSize="24"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4"
                            VerticalOptions="Center">

                            <Label
                                Text="Każda pogoda ma swoją historię"
                                FontSize="12"
                                FontAttributes="Bold"
                                TextColor="#187BA8"/>

                            <Label
                                Text="Uchwyć swój moment i poznaj chwile innych."
                                FontSize="11"
                                TextColor="#6E8CA3"
                                LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- STOPKA -->
                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="7"
                    Margin="0,25,0,0">

                    <Label
                        Text="✦"
                        FontSize="11"
                        TextColor="#69BCE7"
                        VerticalOptions="Center"/>

                    <Label
                        Text="LOCALVIBE  ·  ODKRYWAJ SWÓJ KLIMAT"
                        FontSize="9"
                        CharacterSpacing="1.1"
                        TextColor="#8CA2B6"
                        VerticalOptions="Center"/>

                    <Label
                        Text="✦"
                        FontSize="11"
                        TextColor="#69BCE7"
                        VerticalOptions="Center"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>