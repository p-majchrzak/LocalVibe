                    BackgroundColor="White"
                    BorderColor="#DDEBF5"
                    BorderWidth="1"
                    CornerRadius="16"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    Clicked="OnBackClicked" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="3"
                                 VerticalOptions="Center">

                <Label Text="LocalVibe"
                       FontSize="23"
                       FontAttributes="Bold"
                       CharacterSpacing="-0.7"
                       TextColor="#187BA8" />

                <Label Text="TWOJA PRYWATNOŚĆ"
                       FontSize="9"
                       CharacterSpacing="1.5"
                       TextColor="#73869A" />
            </VerticalStackLayout>
        </Grid>

