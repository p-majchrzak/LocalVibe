<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalVibe.Pages.Shared.PrivacyPolicyPage"
             Title="Polityka prywatności"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F9FF">
    
    <Grid>
        <!-- TŁO -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F6FF" Offset="0.0"/>
                    <GradientStop Color="#F8FAFF" Offset="0.55"/>
                    <GradientStop Color="#F0EFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Border WidthRequest="190"
                HeightRequest="190"
                BackgroundColor="#254EB9E6"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 95"
                HorizontalOptions="End"
                VerticalOptions="Start"
                TranslationX="90"
                TranslationY="-95"/>

        <Grid RowDefinitions="Auto,*">

            <!-- NAGŁÓWEK -->
            <Grid Grid.Row="0"
                  Padding="22,15,22,12"
                  ColumnDefinitions="46,*"
                  ColumnSpacing="13">

                <Border BackgroundColor="#FFFFFF"
                        Stroke="#D6EAF6"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 15"
                        WidthRequest="46"
                        HeightRequest="46">

                    <Label Text="←"
                           FontSize="25"
                           TextColor="#187BA8"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="3"
                                     VerticalOptions="Center">

                    <Label Text="LOCALVIBE"
                           FontSize="10"
                           CharacterSpacing="2"
                           FontAttributes="Bold"
                           TextColor="#258FCB"/>

                    <Label Text="Centrum prywatności"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#20374D"/>
                </VerticalStackLayout>
            </Grid>

            <!-- TREŚĆ -->
            <ScrollView x:Name="PolicyScrollView"
                        Grid.Row="1">

                <VerticalStackLayout Padding="22,12,22,32"
                                     Spacing="20">

                    <!-- KARTA GŁÓWNA -->
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#DCECF7"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 27"
                            Padding="22">

                        <Border.Shadow>
                            <Shadow Brush="#183C75A5"
                                    Offset="0,7"
                                    Radius="18"
                                    Opacity="0.09"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">

                                <Border BackgroundColor="#E1F4FF"
                                        Stroke="#C8EAFB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="68"
                                        HeightRequest="68">

                                    <Label Text="🛡️"
                                           FontSize="34"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Border Grid.Column="1"
                                        BackgroundColor="#E0F8ED"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10,7"
                                        VerticalOptions="Start">

                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="●"
                                               FontSize="8"
                                               TextColor="#22A878"/>

                                        <Label Text="PRYWATNOŚĆ"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="#208761"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Label Text="Polityka&#10;prywatności"
                                   FontSize="31"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   LineHeight="1.1"/>

                            <Label Text="Wszystkie najważniejsze informacje w jednym miejscu."
                                   FontSize="14"
                                   TextColor="#71869A"
                                   LineHeight="1.3"/>

                            <BoxView HeightRequest="1"
                                     Color="#E5EEF5"
                                     Margin="0,5,0,0"/>

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KARTY INFORMACYJNE -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#E1ECF4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 19"
                                Padding="14">

                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="#E1F4FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        HorizontalOptions="Start">
                                    <Label Text="📍"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Label Text="Lokalizacja"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#20374D"/>

                                <Label Text="tekst"
                                       FontSize="12"
                                       TextColor="#8193A4"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E1ECF4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 19"
                                Padding="14">

                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="#FFF0D9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        HorizontalOptions="Start">
                                    <Label Text="📸"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Label Text="Aparat"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#20374D"/>

                                <Label Text="tekst"
                                       FontSize="12"
                                       TextColor="#8193A4"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E1ECF4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 19"
                                Padding="14">

                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="#EDE6FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        HorizontalOptions="Start">
                                    <Label Text="🌤️"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Label Text="Pogoda"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#20374D"/>

                                <Label Text="tekst"
                                       FontSize="12"
                                       TextColor="#8193A4"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="#FFFFFF"
                                Stroke="#E1ECF4"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 19"
                                Padding="14">

                            <VerticalStackLayout Spacing="8">
                                <Border BackgroundColor="#DDF9EE"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        WidthRequest="42"
                                        HeightRequest="42"
                                        HorizontalOptions="Start">
                                    <Label Text="🔐"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>

                                <Label Text="Bezpieczeństwo"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#20374D"/>

                                <Label Text="tekst"
                                       FontSize="12"
                                       TextColor="#8193A4"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- SPIS TREŚCI -->
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#DFEAF3"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 23"
                            Padding="18">

                        <VerticalStackLayout Spacing="13">

                            <Label Text="Spis treści"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"/>

                            <Label Text="Wybierz interesującą Cię sekcję."
                                   FontSize="12"
                                   TextColor="#8A9BAC"/>

                            <Button Text="01   Informacje ogólne"
                                    Clicked="OnGeneralClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>

                            <Button Text="02   Gromadzenie danych"
                                    Clicked="OnDataClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>

                            <Button Text="03   Wykorzystanie danych"
                                    Clicked="OnUsageClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>

                            <Button Text="04   Bezpieczeństwo danych"
                                    Clicked="OnSecurityClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>

                            <Button Text="05   Prawa użytkownika"
                                    Clicked="OnRightsClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>

                            <Button Text="06   Kontakt"
                                    Clicked="OnContactClicked"
                                    BackgroundColor="#F1F8FD"
                                    TextColor="#187BA8"
                                    FontSize="13"
                                    CornerRadius="12"
                                    HeightRequest="45"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- SEKCJA 1 -->
                    <VerticalStackLayout x:Name="GeneralSection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#DFF3FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="01"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#187BA8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Informacje ogólne"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEKCJA 2 -->
                    <VerticalStackLayout x:Name="DataSection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#EDE6FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="02"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#8059C7"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Gromadzenie danych"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEKCJA 3 -->
                    <VerticalStackLayout x:Name="UsageSection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#FFF0D9"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="03"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#B57A21"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Wykorzystanie danych"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEKCJA 4 -->
                    <VerticalStackLayout x:Name="SecuritySection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#DDF9EE"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="04"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#208761"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Bezpieczeństwo danych"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEKCJA 5 -->
                    <VerticalStackLayout x:Name="RightsSection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#FCE5F3"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="05"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#B34E91"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Prawa użytkownika"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- SEKCJA 6 -->
                    <VerticalStackLayout x:Name="ContactSection"
                                         Spacing="12">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="11">

                            <Border BackgroundColor="#E1F4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    WidthRequest="42"
                                    HeightRequest="42">
                                <Label Text="06"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#187BA8"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Column="1"
                                   Text="Kontakt"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#20374D"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#DFEAF3"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 22"
                                Padding="18">

                            <Label Text="tekst"
                                   FontSize="13"
                                   TextColor="#62788D"
                                   LineHeight="1.4"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- STOPKA -->
                    <Border BackgroundColor="#EAF5FC"
                            Stroke="#D6EAF6"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">

                            <Label Text="💙  Dziękujemy, że jesteś z nami"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#187BA8"/>

                            <Label Text="tekst"
                                   FontSize="12"
                                   TextColor="#71869A"
                                   LineHeight="1.3"/>

                            <Label Text="LOCALVIBE • POLITYKA PRYWATNOŚCI"
                                   FontSize="9"
                                   CharacterSpacing="1.2"
                                   FontAttributes="Bold"
                                   TextColor="#8CA3B7"
                                   Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- POWRÓT -->
                    <Button Text="←  Powrót"
                            Clicked="OnBackClicked"
                            BackgroundColor="#187BA8"
                            TextColor="#FFFFFF"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="16"
                            HeightRequest="52"/>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>