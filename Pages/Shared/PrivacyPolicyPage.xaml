<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalVibe.Pages.Shared.PrivacyPolicyPage"
             Title="PrivacyPolicyPage">
    
<ScrollView
    x:Name="PolicyScrollView"
    BackgroundColor="{StaticResource NotFoundBackground}">

    <VerticalStackLayout
        Padding="24,28,24,36"
        Spacing="22">

        <!-- Nagłówek -->
        <VerticalStackLayout Spacing="10">

            <Border
                WidthRequest="66"
                HeightRequest="66"
                Padding="0"
                BackgroundColor="#EAF8FE"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22"
                HorizontalOptions="Center">

                <Label
                    Text="♧"
                    FontSize="38"
                    TextColor="{StaticResource NotFoundPrimary}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Label
                Text="Polityka prywatności"
                Style="{StaticResource NotFoundTitle}"
                FontSize="28" />

            <Label
                Text="Twoja prywatność ma znaczenie"
                FontSize="15"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundPrimary}"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Tekst"
                Style="{StaticResource NotFoundDescription}" />

        </VerticalStackLayout>

        <!-- Informacja -->
        <Border
            BackgroundColor="#F4FAFD"
            Stroke="#D9EFF9"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="16">

            <HorizontalStackLayout Spacing="10">

                <Label
                    Text="ⓘ"
                    FontSize="20"
                    TextColor="{StaticResource NotFoundPrimary}"
                    VerticalOptions="Center" />

                <VerticalStackLayout Spacing="3">

                    <Label
                        Text="Informacje o dokumencie"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="{StaticResource NotFoundText}" />

                    <Label
                        Text="Przeczytaj dokument przed korzystaniem z aplikacji."
                        FontSize="12"
                        TextColor="{StaticResource NotFoundMuted}" />

                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Border>

        <!-- Spis treści -->
        <VerticalStackLayout Spacing="10">

            <Label
                Text="W tym dokumencie"
                FontSize="19"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <VerticalStackLayout Spacing="8">

                <Button
                    Text="01   Informacje ogólne"
                    Style="{StaticResource NotFoundButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnGeneralClicked" />

                <Button
                    Text="02   Zakres danych"
                    Style="{StaticResource NotFoundButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnDataClicked" />

                <Button
                    Text="03   Wykorzystanie danych"
                    Style="{StaticResource NotFoundButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnUsageClicked" />

                <Button
                    Text="04   Bezpieczeństwo"
                    Style="{StaticResource NotFoundButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnSecurityClicked" />

                <Button
                    Text="05   Twoje prawa"
                    Style="{StaticResource NotFoundButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnRightsClicked" />

            </VerticalStackLayout>
        </VerticalStackLayout>

        <BoxView
            HeightRequest="1"
            Color="#E5EDF2" />

        <!-- Sekcja 1 -->
        <VerticalStackLayout
            x:Name="GeneralSection"
            Spacing="9">

            <Label
                Text="01. Informacje ogólne"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <Label
                Text="tekst"
                FontSize="14"
                TextColor="{StaticResource NotFoundMuted}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Sekcja 2 -->
        <VerticalStackLayout
            x:Name="DataSection"
            Spacing="9">

            <Label
                Text="02. Zakres danych"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <Label
                Text="tekst"
                FontSize="14"
                TextColor="{StaticResource NotFoundMuted}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Sekcja 3 -->
        <VerticalStackLayout
            x:Name="UsageSection"
            Spacing="9">

            <Label
                Text="03. Wykorzystanie danych"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <Label
                Text="tekst"
                FontSize="14"
                TextColor="{StaticResource NotFoundMuted}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Sekcja 4 -->
        <VerticalStackLayout
            x:Name="SecuritySection"
            Spacing="9">

            <Label
                Text="04. Bezpieczeństwo danych"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <Label
                Text="tekst"
                FontSize="14"
                TextColor="{StaticResource NotFoundMuted}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Sekcja 5 -->
        <VerticalStackLayout
            x:Name="RightsSection"
            Spacing="9">

            <Label
                Text="05. Twoje prawa"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{StaticResource NotFoundText}" />

            <Label
                Text="tekst"
                FontSize="14"
                TextColor="{StaticResource NotFoundMuted}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>

        <!-- Ważna informacja -->
        <Border
            BackgroundColor="#F5F1FF"
            Stroke="#DFD8F7"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Padding="17">

            <VerticalStackLayout Spacing="7">

                <Label
                    Text="Dane kontaktowe"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{StaticResource NotFoundText}" />

                <Label
                    Text="Tekst"
                    FontSize="13"
                    TextColor="{StaticResource NotFoundMuted}"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>
        </Border>

        <!-- Powrót -->
        <Button
            Text="←   Wróć"
            Style="{StaticResource NotFoundButton}"
            Clicked="OnBackClicked"
            Margin="0,4,0,0" />

        <Label
            Text="LocalVibe • Twoja prywatność ma znaczenie"
            FontSize="12"
            TextColor="{StaticResource NotFoundMuted}"
            HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ScrollView>

  
</ContentPage>