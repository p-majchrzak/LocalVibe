<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LocalVibe.Pages.Admin"
    xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
    x:Class="LocalVibe.Pages.Admin.AdminTabbedPage"
    android:TabbedPage.ToolbarPlacement="Bottom"
    BarBackgroundColor="#FFFFFF"
    BarTextColor="#187BA8"
    SelectedTabColor="#187BA8"
    UnselectedTabColor="#8CA1B4"
    Title="LocalVibe Admin">

    <!-- Panel administratora -->

    <pages:DashboardPage
        Title="Dashboard"
        IconImageSource="dashboard.png" />

    <pages:AnalyticsPage
        Title="Analityka"
        IconImageSource="analytics.png" />

    <pages:ContentModerationPage
        Title="Moderacja"
        IconImageSource="content_moderation.png" />

    <pages:UserManagementPage
        Title="Użytkownicy"
        IconImageSource="user_management.png" />

</TabbedPage>