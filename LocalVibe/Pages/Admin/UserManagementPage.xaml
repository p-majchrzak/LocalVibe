<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="LocalVibe.Pages.Admin.UserManagementPage"
	BackgroundColor="#F5F8FF"
	Shell.NavBarIsVisible="False"
	NavigationPage.HasNavigationBar="False">
	<ScrollView>
		<VerticalStackLayout
			Padding="22,25,22,30"
			Spacing="22">
			<!-- Naglowek -->
			<Grid ColumnDefinitions="*,Auto">
				<VerticalStackLayout Spacing="3">
					<Label Text="localvibe"
						   FontSize="25"
						   FontAttributes="Bold"
						   CharacterSpacing="-0.7"
						   TextColor="#187BA8"/>
					<Label Text="PANEL ADMINISTRATORA"
						   FontSize="9"
						   CharacterSpacing="2"
						   TextColor="#8CA1B4"/>
				</VerticalStackLayout>
				<Border Grid.Column="1"
						BackgroundColor="#E4F5FD"
						StrokeThickness="0"
						Padding="12"
						StrokeShape="RoundRectangle 16"
						VerticalOptions="Center">
					<Label Text="👥"
						   FontSize="22"/>
				</Border>
			</Grid>

			<!-- Tytul -->
			<VerticalStackLayout Spacing="6">
				<Label Text="Użytkownicy."
					   FontSize="30"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
				<Label Text="Zarządzaj kontami społeczności LocalVibe."
					   FontSize="14"
					   TextColor="#73869A"/>
			</VerticalStackLayout>
			<!-- Statystyki -->
			<Grid ColumnDefinitions="*,*"
				  RowDefinitions="Auto,Auto"
				  ColumnSpacing="12"
				  RowSpacing="12">
				<Border BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="15"
						StrokeShape="RoundRectangle 18">
					<VerticalStackLayout Spacing="7">
						<Label Text="WSZYSCY"
							   FontSize="10"
							   CharacterSpacing="1.2"
							   TextColor="#8CA1B4"/>
						<Label Text="1 284"
							   FontSize="27"
							   FontAttributes="Bold"
							   TextColor="#187BA8"/>
						<Label Text="Użytkowników"
							   FontSize="11"
							   TextColor="#73869A"/>
					</VerticalStackLayout>
				</Border>
				<Border Grid.Column="1"
						BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="15"
						StrokeShape="RoundRectangle 18">
					<VerticalStackLayout Spacing="7">
						<Label Text="AKTYWNI"
							   FontSize="10"
							   CharacterSpacing="1.2"
							   TextColor="#8CA1B4"/>
						<Label Text="1 146"
							   FontSize="27"
							   FontAttributes="Bold"
							   TextColor="#187BA8"/>
						<Label Text="Aktywne konta"
							   FontSize="11"
							   TextColor="#73869A"/>
					</VerticalStackLayout>
				</Border>
				<Border Grid.Row="1"
						BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="15"
						StrokeShape="RoundRectangle 18">
					<VerticalStackLayout Spacing="7">
						<Label Text="ZABLOKOWANI"
							   FontSize="10"
							   CharacterSpacing="1.2"
							   TextColor="#8CA1B4"/>
						<Label Text="18"
							   FontSize="27"
							   FontAttributes="Bold"
							   TextColor="#D97777"/>
						<Label Text="Zablokowane konta"
							   FontSize="11"
							   TextColor="#73869A"/>
					</VerticalStackLayout>
				</Border>
				<Border Grid.Row="1"
						Grid.Column="1"
						BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="15"
						StrokeShape="RoundRectangle 18">
					<VerticalStackLayout Spacing="7">
						<Label Text="NOWI"
							   FontSize="10"
							   CharacterSpacing="1.2"
							   TextColor="#8CA1B4"/>
						<Label Text="42"
							   FontSize="27"
							   FontAttributes="Bold"
							   TextColor="#187BA8"/>
						<Label Text="W tym miesiącu"
							   FontSize="11"
							   TextColor="#73869A"/>
					</VerticalStackLayout>
				</Border>
			</Grid>
			<!-- Wyszukiwanie -->
			<VerticalStackLayout Spacing="10">
				<Label Text="Lista użytkowników"
					   FontSize="19"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
				<Border BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="14,2"
						StrokeShape="RoundRectangle 15">
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="10">
						<Label Text="⌕"
							   FontSize="25"
							   TextColor="#8CA1B4"
							   VerticalOptions="Center"/>
						<Entry Grid.Column="1"
							   Placeholder="Szukaj użytkownika..."
							   PlaceholderColor="#A1B3C3"
							   TextColor="#192D45"
							   FontSize="13"
							   BackgroundColor="Transparent"/>
					</Grid>
				</Border>
			</VerticalStackLayout>
			<!-- Filtry -->
			<ScrollView Orientation="Horizontal"
						HorizontalScrollBarVisibility="Never">
				<HorizontalStackLayout Spacing="9">
					<Border BackgroundColor="#187BA8"
							StrokeThickness="0"
							Padding="17,10"
							StrokeShape="RoundRectangle 13">
						<Label Text="Wszyscy"
							   FontSize="12"
							   FontAttributes="Bold"
							   TextColor="White"/>
					</Border>
					<Border BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="17,10"
							StrokeShape="RoundRectangle 13">
						<Label Text="Aktywni"
							   FontSize="12"
							   TextColor="#73869A"/>
					</Border>
					<Border BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="17,10"
							StrokeShape="RoundRectangle 13">
						<Label Text="Zablokowani"
							   FontSize="12"
							   TextColor="#73869A"/>
					</Border>
					<Border BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="17,10"
							StrokeShape="RoundRectangle 13">
						<Label Text="Administratorzy"
							   FontSize="12"
							   TextColor="#73869A"/>
					</Border>
				</HorizontalStackLayout>
			</ScrollView>
			<!-- Uzytkownik 1 -->
			<Border BackgroundColor="White"
					Stroke="#DDEBF5"
					StrokeThickness="1"
					Padding="15"
					StrokeShape="RoundRectangle 20">
				<VerticalStackLayout Spacing="13">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="11">
						<Border BackgroundColor="#E4F5FD"
								StrokeThickness="0"
								StrokeShape="RoundRectangle 22"
								WidthRequest="48"
								HeightRequest="48">
							<Label Text="A"
								   FontSize="20"
								   FontAttributes="Bold"
								   TextColor="#187BA8"
								   HorizontalOptions="Center"
								   VerticalOptions="Center"/>
						</Border>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="4"
											 VerticalOptions="Center">
							<Label Text="Aleksandra Nowak"
								   FontSize="14"
								   FontAttributes="Bold"
								   TextColor="#192D45"/>
							<Label Text="aleksandra@example.com"
								   FontSize="11"
								   TextColor="#8CA1B4"/>
						</VerticalStackLayout>
						<Border Grid.Column="2"
								BackgroundColor="#E7F7EF"
								StrokeThickness="0"
								Padding="9,5"
								StrokeShape="RoundRectangle 9"
								VerticalOptions="Center">
							<Label Text="AKTYWNY"
								   FontSize="9"
								   FontAttributes="Bold"
								   TextColor="#32966A"/>
						</Border>
					</Grid>
					<BoxView HeightRequest="1"
							 Color="#EAF0F5"/>
					<Grid ColumnDefinitions="*,*">
						<VerticalStackLayout Spacing="3">
							<Label Text="ROLA"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="Użytkownik"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="3">
							<Label Text="DOŁĄCZYŁ"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="12.10.2026"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
					</Grid>
					<Grid ColumnDefinitions="*,*"
						  ColumnSpacing="10">
						<Button Text="Szczegóły"
								FontSize="12"
								TextColor="#187BA8"
								BackgroundColor="#E4F5FD"
								CornerRadius="11"
								HeightRequest="42"/>
						<Button Grid.Column="1"
								Text="Zablokuj"
								FontSize="12"
								TextColor="#C45E5E"
								BackgroundColor="#FFF0F0"
								CornerRadius="11"
								HeightRequest="42"/>
					</Grid>
				</VerticalStackLayout>
			</Border>
			<!-- Uzytkownik 2 -->
			<Border BackgroundColor="White"
					Stroke="#DDEBF5"
					StrokeThickness="1"
					Padding="15"
					StrokeShape="RoundRectangle 20">
				<VerticalStackLayout Spacing="13">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="11">
						<Border BackgroundColor="#F0EAFB"
								StrokeThickness="0"
								StrokeShape="RoundRectangle 22"
								WidthRequest="48"
								HeightRequest="48">
							<Label Text="M"
								   FontSize="20"
								   FontAttributes="Bold"
								   TextColor="#8972BD"
								   HorizontalOptions="Center"
								   VerticalOptions="Center"/>
						</Border>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="4"
											 VerticalOptions="Center">
							<Label Text="Michał Kowalski"
								   FontSize="14"
								   FontAttributes="Bold"
								   TextColor="#192D45"/>
							<Label Text="michal@example.com"
								   FontSize="11"
								   TextColor="#8CA1B4"/>
						</VerticalStackLayout>
						<Border Grid.Column="2"
								BackgroundColor="#FFF0F0"
								StrokeThickness="0"
								Padding="9,5"
								StrokeShape="RoundRectangle 9"
								VerticalOptions="Center">
							<Label Text="BLOKADA"
								   FontSize="9"
								   FontAttributes="Bold"
								   TextColor="#C45E5E"/>
						</Border>
					</Grid>
					<BoxView HeightRequest="1"
							 Color="#EAF0F5"/>
					<Grid ColumnDefinitions="*,*">
						<VerticalStackLayout Spacing="3">
							<Label Text="ROLA"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="Użytkownik"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="3">
							<Label Text="DOŁĄCZYŁ"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="08.09.2026"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
					</Grid>
					<Grid ColumnDefinitions="*,*"
						  ColumnSpacing="10">
						<Button Text="Szczegóły"
								FontSize="12"
								TextColor="#187BA8"
								BackgroundColor="#E4F5FD"
								CornerRadius="11"
								HeightRequest="42"/>
						<Button Grid.Column="1"
								Text="Odblokuj"
								FontSize="12"
								TextColor="#32966A"
								BackgroundColor="#E7F7EF"
								CornerRadius="11"
								HeightRequest="42"/>
					</Grid>
				</VerticalStackLayout>
			</Border>
			<!-- Uzytkownik 3 -->
			<Border BackgroundColor="White"
					Stroke="#DDEBF5"
					StrokeThickness="1"
					Padding="15"
					StrokeShape="RoundRectangle 20">
				<VerticalStackLayout Spacing="13">
					<Grid ColumnDefinitions="Auto,*,Auto"
						  ColumnSpacing="11">
						<Border BackgroundColor="#FFF1E5"
								StrokeThickness="0"
								StrokeShape="RoundRectangle 22"
								WidthRequest="48"
								HeightRequest="48">
							<Label Text="P"
								   FontSize="20"
								   FontAttributes="Bold"
								   TextColor="#D18A50"
								   HorizontalOptions="Center"
								   VerticalOptions="Center"/>
						</Border>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="4"
											 VerticalOptions="Center">
							<Label Text="Patryk Wiśniewski"
								   FontSize="14"
								   FontAttributes="Bold"
								   TextColor="#192D45"/>
							<Label Text="patryk@example.com"
								   FontSize="11"
								   TextColor="#8CA1B4"/>
						</VerticalStackLayout>
						<Border Grid.Column="2"
								BackgroundColor="#E4F5FD"
								StrokeThickness="0"
								Padding="9,5"
								StrokeShape="RoundRectangle 9"
								VerticalOptions="Center">
							<Label Text="ADMIN"
								   FontSize="9"
								   FontAttributes="Bold"
								   TextColor="#187BA8"/>
						</Border>
					</Grid>
					<BoxView HeightRequest="1"
							 Color="#EAF0F5"/>
					<Grid ColumnDefinitions="*,*">
						<VerticalStackLayout Spacing="3">
							<Label Text="ROLA"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="Administrator"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
						<VerticalStackLayout Grid.Column="1"
											 Spacing="3">
							<Label Text="DOŁĄCZYŁ"
								   FontSize="9"
								   CharacterSpacing="1"
								   TextColor="#8CA1B4"/>
							<Label Text="21.08.2026"
								   FontSize="12"
								   TextColor="#192D45"/>
						</VerticalStackLayout>
					</Grid>
					<Button Text="Szczegóły"
							FontSize="12"
							TextColor="#187BA8"
							BackgroundColor="#E4F5FD"
							CornerRadius="11"
							HeightRequest="42"/>
				</VerticalStackLayout>
			</Border>
			<!-- Stopka -->
			<Label Text="LOCALVIBE ADMIN PANEL"
				   FontSize="10"
				   CharacterSpacing="2"
				   TextColor="#A1B3C3"
				   HorizontalTextAlignment="Center"
				   Margin="0,5,0,0"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>





