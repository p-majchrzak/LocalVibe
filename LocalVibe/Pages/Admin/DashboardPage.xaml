									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="2"
												 VerticalOptions="End"
												 Spacing="6">
