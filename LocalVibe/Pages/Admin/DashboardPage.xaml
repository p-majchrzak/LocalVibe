					  RowDefinitions="Auto,Auto"
					  ColumnSpacing="12"
					  RowSpacing="12">
					<!-- Uzytkownicy -->
					<Border BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="15"
							StrokeShape="RoundRectangle 18">
