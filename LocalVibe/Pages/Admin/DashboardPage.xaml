<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="LocalVibe.Pages.Admin.DashboardPage"
	BackgroundColor="#F5F8FF"
	Shell.NavBarIsVisible="False"
	NavigationPage.HasNavigationBar="False">
	<ScrollView>
		<VerticalStackLayout
			Padding="22,25,22,30"
			Spacing="22">
			<!-- Naglowek -->
			<Grid ColumnDefinitions="*,Auto">
				<VerticalStackLayout Spacing="3">
					<Label Text="localvibe"
						   FontSize="25"
						   FontAttributes="Bold"
						   CharacterSpacing="-0.7"
						   TextColor="#187BA8"/>
					<Label Text="PANEL ADMINISTRATORA"
						   FontSize="9"
						   CharacterSpacing="2"
						   TextColor="#8CA1B4"/>
				</VerticalStackLayout>
				<Border Grid.Column="1"
						BackgroundColor="#E4F5FD"
						StrokeThickness="0"
						Padding="12"
						StrokeShape="RoundRectangle 16"
						VerticalOptions="Center">
					<Label Text="📊"
						   FontSize="22"/>
				</Border>
			</Grid>
			<!-- Powitanie -->
			<VerticalStackLayout Spacing="6">
				<Label Text="Dashboard."
					   FontSize="30"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
				<Label Text="Przegląd najważniejszych informacji o LocalVibe."
					   FontSize="14"
					   TextColor="#73869A"/>
			</VerticalStackLayout>
			<!-- Status systemu -->
			<Border BackgroundColor="#E7F7EF"
					StrokeThickness="0"
					Padding="15"
					StrokeShape="RoundRectangle 16">
				<Grid ColumnDefinitions="Auto,*,Auto"
					  ColumnSpacing="11">
					<Border BackgroundColor="#FFFFFF"
							StrokeThickness="0"
							Padding="9"
							StrokeShape="RoundRectangle 12"
							VerticalOptions="Center">
						<Label Text="✓"
							   FontSize="17"
							   FontAttributes="Bold"
							   TextColor="#32966A"/>
					</Border>
					<VerticalStackLayout Grid.Column="1"
										 Spacing="3"
										 VerticalOptions="Center">
						<Label Text="System działa prawidłowo"
							   FontSize="13"
							   FontAttributes="Bold"
							   TextColor="#267B57"/>
						<Label Text="Wszystkie moduły w stanie demonstracyjnym"
							   FontSize="10"
							   TextColor="#559579"/>
					</VerticalStackLayout>
					<Border Grid.Column="2"
							BackgroundColor="#FFFFFF"
							StrokeThickness="0"
							Padding="9,5"
							StrokeShape="RoundRectangle 9"
							VerticalOptions="Center">
						<Label Text="ONLINE"
