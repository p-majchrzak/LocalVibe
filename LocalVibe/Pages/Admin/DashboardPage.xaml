								   FontSize="11"
								   TextColor="#73869A"/>
							<Label Text="Do sprawdzenia"
								   FontSize="10"
								   TextColor="#C45E5E"/>
						</VerticalStackLayout>
					</Border>
				</Grid>
			</VerticalStackLayout>
			<!-- Aktywnosc -->
			<VerticalStackLayout Spacing="12">
