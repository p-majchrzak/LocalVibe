								   FontSize="10"
								   TextColor="#32966A"/>
						</VerticalStackLayout>
					</Border>
					<!-- Komentarze -->
					<Border Grid.Row="1"
							BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="15"
							StrokeShape="RoundRectangle 18">
						<VerticalStackLayout Spacing="8">
							<Border BackgroundColor="#FFF1E5"
									StrokeThickness="0"
									Padding="9"
									StrokeShape="RoundRectangle 12"
									HorizontalOptions="Start">
								<Label Text="💬"
									   FontSize="19"/>
							</Border>
							<Label Text="12 409"
								   FontSize="27"
								   FontAttributes="Bold"
								   TextColor="#D18A50"/>
							<Label Text="Komentarze"
								   FontSize="11"
								   TextColor="#73869A"/>
							<Label Text="Łącznie w aplikacji"
								   FontSize="10"
								   TextColor="#8CA1B4"/>
						</VerticalStackLayout>
					</Border>
					<!-- Zgloszenia -->
					<Border Grid.Row="1"
							Grid.Column="1"
							BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="15"
							StrokeShape="RoundRectangle 18">
						<VerticalStackLayout Spacing="8">
							<Border BackgroundColor="#FFF0F0"
									StrokeThickness="0"
									Padding="9"
									StrokeShape="RoundRectangle 12"
									HorizontalOptions="Start">
								<Label Text="⚑"
									   FontSize="19"
									   TextColor="#C45E5E"/>
							</Border>
							<Label Text="18"
								   FontSize="27"
								   FontAttributes="Bold"
								   TextColor="#C45E5E"/>
