									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1"
												 VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="65"
										 BackgroundColor="#A5E0F9"
