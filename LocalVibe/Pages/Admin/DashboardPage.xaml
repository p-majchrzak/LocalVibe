							<Border BackgroundColor="#E4F5FD"
									StrokeThickness="0"
									Padding="9"
									StrokeShape="RoundRectangle 12"
									HorizontalOptions="Start">
								<Label Text="👥"
									   FontSize="19"/>
							</Border>
							<Label Text="1 284"
								   FontSize="27"
								   FontAttributes="Bold"
								   TextColor="#187BA8"/>
							<Label Text="Użytkownicy"
								   FontSize="11"
								   TextColor="#73869A"/>
							<Label Text="+12% w tym miesiącu"
								   FontSize="10"
								   TextColor="#32966A"/>
						</VerticalStackLayout>
					</Border>
					<!-- Publikacje -->
					<Border Grid.Column="1"
							BackgroundColor="White"
							Stroke="#DDEBF5"
							StrokeThickness="1"
							Padding="15"
							StrokeShape="RoundRectangle 18">
						<VerticalStackLayout Spacing="8">
							<Border BackgroundColor="#F0EAFB"
									StrokeThickness="0"
									Padding="9"
									StrokeShape="RoundRectangle 12"
									HorizontalOptions="Start">
