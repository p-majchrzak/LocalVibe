							<Label Text="Liczba publikacji"
								   FontSize="13"
								   FontAttributes="Bold"
								   TextColor="#192D45"/>
							<Label Grid.Column="1"
								   Text="1 246"
								   FontSize="13"
								   FontAttributes="Bold"
								   TextColor="#187BA8"/>
						</Grid>
						<!-- Wykres demonstracyjny -->
						<Grid ColumnDefinitions="*,*,*,*,*,*,*"
							  HeightRequest="125"
							  ColumnSpacing="10">
							<VerticalStackLayout VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="42"
										 BackgroundColor="#A5E0F9"
										 CornerRadius="5"/>
								<Label Text="Pn"
									   FontSize="10"
