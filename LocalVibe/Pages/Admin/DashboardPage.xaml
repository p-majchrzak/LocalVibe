									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="3"
												 VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="88"
										 BackgroundColor="#4EB9E6"
										 CornerRadius="5"/>
								<Label Text="Cz"
									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="4"
												 VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="72"
										 BackgroundColor="#A5E0F9"
										 CornerRadius="5"/>
								<Label Text="Pt"
									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="5"
												 VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="105"
										 BackgroundColor="#187BA8"
										 CornerRadius="5"/>
								<Label Text="Sb"
									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="6"
												 VerticalOptions="End"
												 Spacing="6">
								<BoxView HeightRequest="60"
										 BackgroundColor="#A5E0F9"
										 CornerRadius="5"/>
								<Label Text="Nd"
									   FontSize="10"
									   TextColor="#8CA1B4"
									   HorizontalTextAlignment="Center"/>
							</VerticalStackLayout>
						</Grid>
						<Label Text="Wykres prezentuje przykładowe dane aktywności."
							   FontSize="10"
							   TextColor="#A1B3C3"/>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
			<!-- Ostatnie zdarzenia -->
			<VerticalStackLayout Spacing="12">
				<Label Text="Ostatnia aktywność"
					   FontSize="19"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
				<Border BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="16"
						StrokeShape="RoundRectangle 20">
					<VerticalStackLayout Spacing="15">
						<!-- Zdarzenie 1 -->
						<Grid ColumnDefinitions="Auto,*,Auto"
							  ColumnSpacing="11">
							<Border BackgroundColor="#E4F5FD"
									StrokeThickness="0"
									Padding="10"
									StrokeShape="RoundRectangle 12">
								<Label Text="👤"
									   FontSize="17"/>
							</Border>
							<VerticalStackLayout Grid.Column="1"
												 Spacing="3"
												 VerticalOptions="Center">
								<Label Text="Nowy użytkownik"
									   FontSize="12"
									   FontAttributes="Bold"
									   TextColor="#192D45"/>
								<Label Text="Anna Nowak utworzyła konto"
									   FontSize="10"
									   TextColor="#8CA1B4"/>
							</VerticalStackLayout>
							<Label Grid.Column="2"
								   Text="10:42"
								   FontSize="10"
								   TextColor="#8CA1B4"
								   VerticalOptions="Center"/>
						</Grid>
						<BoxView HeightRequest="1"
								 Color="#EAF0F5"/>
						<!-- Zdarzenie 2 -->
						<Grid ColumnDefinitions="Auto,*,Auto"
							  ColumnSpacing="11">
							<Border BackgroundColor="#F0EAFB"
									StrokeThickness="0"
									Padding="10"
									StrokeShape="RoundRectangle 12">
								<Label Text="📸"
									   FontSize="17"/>
							</Border>
							<VerticalStackLayout Grid.Column="1"
												 Spacing="3"
												 VerticalOptions="Center">
								<Label Text="Nowa publikacja"
									   FontSize="12"
									   FontAttributes="Bold"
									   TextColor="#192D45"/>
								<Label Text="Dodano nowy post do feedu"
									   FontSize="10"
									   TextColor="#8CA1B4"/>
							</VerticalStackLayout>
							<Label Grid.Column="2"
								   Text="09:35"
								   FontSize="10"
								   TextColor="#8CA1B4"
								   VerticalOptions="Center"/>
						</Grid>
						<BoxView HeightRequest="1"
								 Color="#EAF0F5"/>
						<!-- Zdarzenie 3 -->
						<Grid ColumnDefinitions="Auto,*,Auto"
							  ColumnSpacing="11">
							<Border BackgroundColor="#FFF0F0"
									StrokeThickness="0"
									Padding="10"
									StrokeShape="RoundRectangle 12">
								<Label Text="⚑"
									   FontSize="17"
									   TextColor="#C45E5E"/>
							</Border>
							<VerticalStackLayout Grid.Column="1"
												 Spacing="3"
												 VerticalOptions="Center">
								<Label Text="Nowe zgłoszenie"
									   FontSize="12"
									   FontAttributes="Bold"
									   TextColor="#192D45"/>
								<Label Text="Zgłoszono publikację użytkownika"
									   FontSize="10"
									   TextColor="#8CA1B4"/>
							</VerticalStackLayout>
							<Label Grid.Column="2"
								   Text="08:17"
								   FontSize="10"
								   TextColor="#8CA1B4"
								   VerticalOptions="Center"/>
						</Grid>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
			<!-- Szybki przeglad -->
			<VerticalStackLayout Spacing="12">
				<Label Text="Przegląd systemu"
					   FontSize="19"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
				<Border BackgroundColor="White"
						Stroke="#DDEBF5"
						StrokeThickness="1"
						Padding="17"
						StrokeShape="RoundRectangle 20">
					<VerticalStackLayout Spacing="14">
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Baza danych"
								   FontSize="12"
								   TextColor="#192D45"/>
							<Label Grid.Column="1"
								   Text="DEMO"
								   FontSize="10"
								   FontAttributes="Bold"
								   TextColor="#187BA8"/>
						</Grid>
						<BoxView HeightRequest="1"
								 Color="#EAF0F5"/>
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Moduł pogody"
								   FontSize="12"
								   TextColor="#192D45"/>
							<Label Grid.Column="1"
								   Text="NIEPODŁĄCZONY"
								   FontSize="9"
								   FontAttributes="Bold"
								   TextColor="#D18A50"/>
						</Grid>
						<BoxView HeightRequest="1"
								 Color="#EAF0F5"/>
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Powiadomienia"
								   FontSize="12"
								   TextColor="#192D45"/>
							<Label Grid.Column="1"
								   Text="NIEPODŁĄCZONE"
								   FontSize="9"
								   FontAttributes="Bold"
								   TextColor="#D18A50"/>
						</Grid>
						<BoxView HeightRequest="1"
								 Color="#EAF0F5"/>
						<Grid ColumnDefinitions="*,Auto">
							<Label Text="Moduł moderacji"
								   FontSize="12"
								   TextColor="#192D45"/>
							<Label Grid.Column="1"
								   Text="DEMO"
								   FontSize="10"
								   FontAttributes="Bold"
								   TextColor="#187BA8"/>
						</Grid>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
			<!-- Stopka -->
			<Label Text="LOCALVIBE ADMIN PANEL"
				   FontSize="10"
				   CharacterSpacing="2"
				   TextColor="#A1B3C3"
				   HorizontalTextAlignment="Center"
				   Margin="0,5,0,0"/>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>

