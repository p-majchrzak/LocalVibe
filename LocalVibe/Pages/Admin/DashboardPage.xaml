							   FontAttributes="Bold"
							   TextColor="#32966A"/>
					</Border>
				</Grid>
			</Border>
			<!-- Statystyki -->
			<VerticalStackLayout Spacing="12">
				<Label Text="Statystyki aplikacji"
					   FontSize="19"
					   FontAttributes="Bold"
					   TextColor="#192D45"/>
