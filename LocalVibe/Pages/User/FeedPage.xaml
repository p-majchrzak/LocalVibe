<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LocalVibe.Pages.User.FeedPage"
    BackgroundColor="#F5F8FF"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,25,22,30"
            Spacing="22">
            <!-- Naglowek -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="localvibe"
                           FontSize="25"
                           FontAttributes="Bold"
                           CharacterSpacing="-0.7"
                           TextColor="#187BA8"/>
                    <Label Text="YOUR WORLD, YOUR VIBE"
                           FontSize="9"
                           CharacterSpacing="2"
                           TextColor="#8CA1B4"/>
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="#E4F5FD"
                        StrokeThickness="0"
                        Padding="12"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text=""
                           FontSize="22"/>
                </Border>
            </Grid>
            <!-- Tytul -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Odkrywaj."
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="#192D45"/>
                <Label Text="Zobacz świat oczami innych użytkowników."
                       FontSize="14"
                       TextColor="#73869A"/>
            </VerticalStackLayout>
            <!-- Filtry -->
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="9">
                    <Border BackgroundColor="#187BA8"
                            StrokeThickness="0"
                            Padding="17,10"
                            StrokeShape="RoundRectangle 14">
                        <Label Text="Wszystkie"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="White"/>
                    </Border>
                    <Border BackgroundColor="White"
                            Stroke="#DDEBF5"
                            StrokeThickness="1"
                            Padding="17,10"
                            StrokeShape="RoundRectangle 14">
                        <Label Text="Znajomi"
                               FontSize="12"
                               TextColor="#73869A"/>
                    </Border>
                    <Border BackgroundColor="White"
                            Stroke="#DDEBF5"
                            StrokeThickness="1"
                            Padding="17,10"
                            StrokeShape="RoundRectangle 14">
                        <Label Text="W pobliżu"
                               FontSize="12"
                               TextColor="#73869A"/>
                    </Border>
                    <Border BackgroundColor="White"
                            Stroke="#DDEBF5"
                            StrokeThickness="1"
                            Padding="17,10"
                            StrokeShape="RoundRectangle 14">
                        <Label Text="Popularne"
                               FontSize="12"
                               TextColor="#73869A"/>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
            <!-- Post 1-->
            <Border BackgroundColor="White"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="15">
                <VerticalStackLayout Spacing="13">
                    <!-- Autor -->
                    <Grid ColumnDefinitions="Auto,*, Auto"
                          ColumnSpacing="11">
                        <Border BackgroundColor="#E4F5FD"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                WidthRequest="44"
                                HeightRequest="44">
                            <Label Text="A"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#187BA8"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Aleksandra"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#192D45"/>
                            <Label Text="2 godziny temu"
                                   FontSize="11"
                                   TextColor="#8CA1B4"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="..."
                               FontSize="18"
                               TextColor="#8CA1B4"
                               VerticalOptions="Center"/>
                    </Grid>
                    <!-- Zdjecie -->
                    <Border BackgroundColor="#DDEFFA"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17"
                            HeightRequest="300">
                        <Grid>
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="8">
                                <Label Text=""
                                       FontSize="55"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Miejsce na zdjęcie"
                                       FontSize="13"
                                       TextColor="#187BA8"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Pogoda i lokalizacja -->
                    <Grid ColumnDefinitions="*, *">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="*"
                                   FontSize="15"/>
                            <Label Text="22°C"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               HorizontalOptions="End">
                            <Label Text="+"
                                   FontSize="15"
                                   TextColor="#187BA8"/>
                            <Label Text="Kraków"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Label Text="Piękny dzień na spacer!"
                           FontSize="14"
                           TextColor="#192D45"/>
                    <BoxView HeightRequest="1"
                             Color="#EAF0F5"/>
                    <!-- Reakcje -->
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="♡"
                                   FontSize="23"
                                   TextColor="#187BA8"/>
                            <Label Text="128"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               Margin="18,0,0,0">
                            <Label Text=""
                                   FontSize="17"/>
                            <Label Text="14"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="3"
                               Text="Udostępnij"
                               FontSize="12"
                               TextColor="#187BA8"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Post 2 -->
            <Border BackgroundColor="White"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="15">
                <VerticalStackLayout Spacing="13">
                    <!-- Autor -->
                    <Grid ColumnDefinitions="Auto,*, Auto"
                          ColumnSpacing="11">
                        <Border BackgroundColor="#F0EAFB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                WidthRequest="44"
                                HeightRequest="44">
                            <Label Text="M"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#8972BD"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Michał"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#192D45"/>
                            <Label Text="5 godzin temu"
                                   FontSize="11"
                                   TextColor="#8CA1B4"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="..."
                               FontSize="18"
                               TextColor="#8CA1B4"
                               VerticalOptions="Center"/>
                    </Grid>
                    <!-- Zdjecie -->
                    <Border BackgroundColor="#E8E4F5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 17"
                            HeightRequest="300">
                        <Grid>
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Spacing="8">
                                <Label Text=""
                                       FontSize="55"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="Miejsce na zdjęcie"
                                       FontSize="13"
                                       TextColor="#8972BD"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Pogoda i lokalizacja -->
                    <Grid ColumnDefinitions="*,*">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text=""
                                   FontSize="15"/>
                            <Label Text="16°C"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               HorizontalOptions="End">
                            <Label Text=" "
                                   FontSize="15"
                                   TextColor="#187BA8"/>
                            <Label Text="Warszawa"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                    <Label Text="Czasami warto po prostu zwolnić."
                           FontSize="14"
                           TextColor="#192D45"/>
                    <BoxView HeightRequest="1"
                             Color="#EAF0F5"/>
                    <!-- Reakcje -->
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="♡"
                                   FontSize="23"
                                   TextColor="#187BA8"/>
                            <Label Text="86"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="6"
                                               Margin="18,0,0,0">
                            <Label Text=""
                                   FontSize="17"/>
                            <Label Text="9"
                                   FontSize="12"
                                   TextColor="#73869A"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="3"
                               Text="Udostępnij"
                               FontSize="12"
                               TextColor="#187BA8"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Stopka -->
            <Label Text="MOMENTS, NOT PERFECTION"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="#A1B3C3"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>