<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LocalVibe.Pages.User.SettingsPage"
    BackgroundColor="#F5F8FF"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,35,22,30"
            Spacing="22">
            <!-- HEADER -->
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="localvibe"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#187BA8" />
                <Label
                    Text="YOUR WORLD, YOUR VIBE"
                    FontSize="10"
                    CharacterSpacing="2"
                    TextColor="#8CA1B4" />
            </VerticalStackLayout>
            <!--TITLE-->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Ustawienia."
                    FontSize="29"
                    FontAttributes="Bold"
                    TextColor="#192D45" />
                <Label
                    Text="Zarządzaj swoim kontem i preferencjami."
                    FontSize="13"
                    TextColor="#73869A" />
            </VerticalStackLayout>
            <!-- ACCOUNT CARD -->
            <Border
                BackgroundColor="White"
                Stroke="#DDEBF5"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="17">
                <Grid
                    ColumnDefinitions="Auto,*, Auto"
                    ColumnSpacing="13">
                    <Border
                        WidthRequest="52"
                        HeightRequest="52"
                        BackgroundColor="#EAF4FC"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16">
                        <Label
                            Text=""
                            FontSize="25"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="4">
                        <Label
                            Text="Piotr Majchrzak"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="#192D45" />
                        <Label
                            Text="@piotr"
                            FontSize="12"
                            TextColor="#73869A" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="2"
                        Text="&gt;"
                        FontSize="27"
                        TextColor="#8CA1B4"
                        VerticalOptions="Center" />
                </Grid>
            </Border>
            <!-- ACCOUNT SETTINGS -->
            <VerticalStackLayout Spacing="11">
                <Label
                    Text="KONTO"
                    FontSize="11"
                    CharacterSpacing="1.5"
                    FontAttributes="Bold"
                    TextColor="#8CA1B4" />
                <Border
                    BackgroundColor="White"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                    <VerticalStackLayout Spacing="0">
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text=""
                                FontSize="20"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Dane osobowe"
                                FontSize="14"
                                TextColor="#192D45"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                Text="&gt;"
                                FontSize="23"
                                TextColor="#8CA1B4"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView
                            HeightRequest="1"
                            Color="#EDF2F7"
                            Margin="0,8" />
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text=""
                                FontSize="20"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Zmiana hasła"
                                FontSize="14"
                                TextColor="#192D45"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                Text="&gt;"
                                FontSize="23"
                                TextColor="#8CA1B4"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView
                            HeightRequest="1"
                            Color="#EDF2F7"
                            Margin="0,8" />
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text="🔒"
                                FontSize="20"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Prywatność i bezpieczeństwo"
                                FontSize="13"
                                TextColor="#192D45"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                Text="&gt;"
                                FontSize="23"
                                TextColor="#8CA1B4"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- PREFERENCES -->
            <VerticalStackLayout Spacing="11">
                <Label
                    Text="PREFERENCJE"
                    FontSize="11"
                    CharacterSpacing="1.5"
                    FontAttributes="Bold"
                    TextColor="#8CA1B4" />
                <Border
                    BackgroundColor="White"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                    <VerticalStackLayout Spacing="0">
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text=""
                                FontSize="20"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="3">
                                <Label
                                    Text="Powiadomienia"
                                    FontSize="14"
                                    TextColor="#192D45" />
                                <Label
                                    Text="Zarządzaj powiadomieniami"
                                    FontSize="11"
                                    TextColor="#8CA1B4" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="True"
                                OnColor="#A5E0F9"
                                ThumbColor="#187BA8"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView
                            HeightRequest="1"
                            Color="#EDF2F7"
                            Margin="0,8" />
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text=""
                                FontSize="20"
                                VerticalOptions="Center" />
                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="3">
                                <Label
                                    Text="Lokalizacja"
                                    FontSize="14"
                                    TextColor="#192D45" />
                                <Label
                                    Text="Używanie lokalizacji w aplikacji"
                                    FontSize="11"
                                    TextColor="#8CA1B4" />
                            </VerticalStackLayout>
                            <Switch
                                Grid.Column="2"
                                IsToggled="True"
                                OnColor="#A5E0F9"
                                ThumbColor="#187BA8"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- INFORMATION -->
            <VerticalStackLayout Spacing="11">
                <Label
                    Text="INFORMACJE"
                    FontSize="11"
                    CharacterSpacing="1.5"
                    FontAttributes="Bold"
                    TextColor="#8CA1B4" />
                <Border
                    BackgroundColor="White"
                    Stroke="#DDEBF5"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="16">
                    <VerticalStackLayout Spacing="0">
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text=""
                                FontSize="20"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="Polityka prywatności"
                                FontSize="14"
                                TextColor="#192D45"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                Text="&gt;"
                                FontSize="23"
                                TextColor="#8CA1B4"
                                VerticalOptions="Center" />
                        </Grid>
                        <BoxView
                            HeightRequest="1"
                            Color="#EDF2F7"
                            Margin="0,8" />
                        <Grid
                            ColumnDefinitions="Auto,*, Auto"
                            ColumnSpacing="13"
                            Padding="0,8">
                            <Label
                                Text="ℹ️"
                                FontSize="20"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Text="O aplikacji"
                                FontSize="14"
                                TextColor="#192D45"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="2"
                                Text="&gt;"
                                FontSize="23"
                                TextColor="#8CA1B4"
                                VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- LOGOUT -->
            <VerticalStackLayout Spacing="10">
                <Button
                    Text="Wyloguj się"
                    HeightRequest="54"
                    BackgroundColor="#FFF0F0"
                    TextColor="#C45E5E"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    BorderWidth="1"
                    BorderColor="#F3DADA" />
                <Label
                    Text="Po wylogowaniu konieczne będzie ponowne zalogowanie."
                    FontSize="11"
                    TextColor="#8CA1B4"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <!-- VERSION -->
            <VerticalStackLayout
                Spacing="4"
                Margin="0,5,0,0">
                <Label
                    Text="LOCALVIBE"
                    FontSize="11"
                    FontAttributes="Bold"
                    CharacterSpacing="2"
                    TextColor="#A1B3C3"
                    HorizontalTextAlignment="Center" />
                <Label
                    Text="Wersja 1.0.0"
                    FontSize="10"
                    TextColor="#A1B3C3"
                    HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>