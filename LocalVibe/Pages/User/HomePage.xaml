<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="LocalVibe.Pages.User.HomePage"
    BackgroundColor="#F5F8FF"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,25,22,30"
            Spacing="23">
            <!-- Naglowek -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="localvibe"
                           FontSize="25"
                           FontAttributes="Bold"
                           CharacterSpacing="-0.7"
                           TextColor="#187BA8"/>
                    <Label Text="YOUR WORLD, YOUR VIBE"
                           FontSize="9"
                           CharacterSpacing="2"
                           TextColor="#8CA1B4"/>
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="#E4F5FD"
                        StrokeThickness="0"
                        Padding="12"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text=""
                           FontSize="23"
                           TextColor="#187BA8"/>
                </Border>
            </Grid>
            <!-- Powitanie -->
            <VerticalStackLayout Spacing="7">
                <Label Text="Cześć!"
                       FontSize="29"
                       FontAttributes="Bold"
                       TextColor="#192D45"/>
                <Label Text="Co dzieje się dzisiaj w Twoim świecie?"
                       FontSize="14"
                       TextColor="#73869A"/>
            </VerticalStackLayout>
            <!-- Karta pogody -->
            <Border BackgroundColor="#187BA8"
                    StrokeThickness="0"
                    Padding="20"
                    StrokeShape="RoundRectangle 22">
                <Grid ColumnDefinitions="*, Auto"
                      RowDefinitions="Auto, Auto, Auto">
                    <VerticalStackLayout Spacing="7">
                        <Label Text="TWOJA POGODA"
                               FontSize="10"
                               CharacterSpacing="2"
                               TextColor="#D5F0FC"/>
                        <Label Text="-- °C"
                               FontSize="37"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Oczekiwanie na dane pogodowe"
                               FontSize="12"
                               TextColor="#D5F0FC"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1"
                           Text="*"
                           FontSize="55"
                           TextColor="#FFFFFF"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="2"
                          Margin="0,18,0,0"
                          Padding="0,12,0,0">
                        <BoxView HeightRequest="1"
                                 Color="#5A9DBB"
                                 VerticalOptions="Start"/>
                        <Grid ColumnDefinitions="*, *"
                              Margin="0,12,0,0">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="LOKALIZACJA"
                                       FontSize="9"
                                       CharacterSpacing="1"
                                       TextColor="#D5F0FC"/>
                                <Label Text="Nieznana"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">
                                <Label Text="WARUNKI"
                                       FontSize="9"
                                       CharacterSpacing="1"
                                       TextColor="#D5F0FC"/>
                                <Label Text="Brak danych"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="White"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <!-- Sekcja dnia -->
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Twoja chwila"
                           FontSize="19"
                           FontAttributes="Bold"
                           TextColor="#192D45"/>
                    <Label Grid.Column="1"
                           Text="TODAY"
                           FontSize="10"
                           CharacterSpacing="1.5"
                           TextColor="#8CA1B4"
                           VerticalOptions="Center"/>
                </Grid>
                <Border BackgroundColor="White"
                        Stroke="#DDEBF5"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="13">
                            <Border BackgroundColor="#E4F5FD"
                                    StrokeThickness="0"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 14">
                                <Label Text=""
                                       FontSize="25"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="Zatrzymaj moment"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#192D45"/>
                                <Label Text="Uchwyć to, co dzieje się wokół Ciebie."
                                       FontSize="12"
                                       TextColor="#73869A"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1"
                                 Color="#EAF0F5"/>
                        <Label Text="Każdy dzień ma swoją historię. Podziel się swoją chwilą ze społecznością LocalVibe."
                               FontSize="13"
                               TextColor="#73869A"
                               LineHeight="1.3"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- Ostatnia aktywnosc -->
            <VerticalStackLayout Spacing="12">
                <Label Text="Odkrywaj społeczność"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="#192D45"/>
                <Border BackgroundColor="White"
                        Stroke="#DDEBF5"
                        StrokeThickness="1"
                        Padding="18"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="13">
                            <Border BackgroundColor="#E4F5FD"
                                    StrokeThickness="0"
                                    Padding="12"
                                    StrokeShape="RoundRectangle 14">
                                <Label Text=""
                                       FontSize="25"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="Świat pełen chwil"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#192D45"/>
                                <Label Text="Zobacz, co udostępniają inni użytkownicy."
                                       FontSize="12"
                                       TextColor="#73869A"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Border BackgroundColor="#F5F8FF"
                                StrokeThickness="0"
                                Padding="15"
                                StrokeShape="RoundRectangle 14">
                            <Label Text="Tutaj pojawią się najnowsze publikacje społeczności."
                                   FontSize="12"
                                   TextColor="#8CA1B4"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- Stopka -->
            <Label Text="MOMENTS, NOT PERFECTION"
                   FontSize="10"
                   CharacterSpacing="2"
                   TextColor="#A1B3C3"
                   HorizontalTextAlignment="Center"
                   Margin="0,5,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>