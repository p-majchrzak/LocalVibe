<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LocalVibe.Pages.Shared.ErrorPage"
             Title="Wystąpił błąd"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F5F8FF">

    <Grid Padding="25"
          RowDefinitions="Auto,*,Auto">

        <!-- LOGO -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="4"
                             HorizontalOptions="Center">

            <Image Source="appicon.png"
                   WidthRequest="55"
                   HeightRequest="55"
                   Aspect="AspectFit" />

            <Label Text="LocalVibe"
                   FontSize="24"
                   FontAttributes="Bold"
                   CharacterSpacing="-0.7"
                   TextColor="#187BA8"
                   HorizontalTextAlignment="Center" />

            <Label Text="YOUR WORLD, YOUR VIBE"
                   FontSize="9"
                   CharacterSpacing="1.8"
                   TextColor="#73869A"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- KOMUNIKAT -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="17"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">

            <!-- IKONA BŁĘDU -->
            <Grid WidthRequest="150"
                  HeightRequest="150"
                  HorizontalOptions="Center">

                <Ellipse WidthRequest="145"
                         HeightRequest="145"
                         Fill="#A5E0F9"
                         Opacity="0.25"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <Ellipse WidthRequest="108"
                         HeightRequest="108"
                         Fill="White"
                         HorizontalOptions="Center"
                         VerticalOptions="Center" />

                <Border WidthRequest="76"
                        HeightRequest="76"
                        BackgroundColor="#E4F5FD"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                    <Label Text="!"
                           FontSize="49"
                           FontAttributes="Bold"
                           TextColor="#187BA8"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <Label Text="Ups! Coś poszło nie tak"
                   FontSize="27"
                   FontAttributes="Bold"
                   CharacterSpacing="-0.8"
                   TextColor="#192D45"
                   HorizontalTextAlignment="Center" />

            <Label x:Name="ErrorMessageLabel"
                   Text="Wystąpił nieoczekiwany błąd. Spróbuj ponownie za chwilę."
                   FontSize="14"
                   TextColor="#73869A"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   MaximumWidthRequest="320"
                   LineHeight="1.4" />

            <!-- PONÓW -->
            <Button Text="Spróbuj ponownie  ↻"
                    BackgroundColor="#187BA8"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="17"
                    HeightRequest="56"
                    HorizontalOptions="Fill"
                    Margin="0,12,0,0"
                    Clicked="OnRetryClicked" />

            <!-- STRONA GŁÓWNA -->
            <Button Text="← Wróć na stronę główną"
                    BackgroundColor="White"
                    TextColor="#187BA8"
                    BorderColor="#DDEBF5"
                    BorderWidth="1"
                    FontSize="14"
                    FontAttributes="Bold"
                    CornerRadius="17"
                    HeightRequest="54"
                    HorizontalOptions="Fill"
                    Clicked="OnHomeClicked" />

        </VerticalStackLayout>

        <!-- STOPKA -->
        <Label Grid.Row="2"
               Text="Twoje chwile czekają na odkrycie. ✦"
               FontSize="11"
               TextColor="#8CA1B4"
               HorizontalTextAlignment="Center"
               HorizontalOptions="Center"
               Margin="0,15,0,0" />

    </Grid>
</ContentPage>